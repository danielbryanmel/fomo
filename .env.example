# Copie para .env.local (não versionado). Só valores PÚBLICOS aqui.
# Supabase → Project Settings → API Keys → "Publishable key"
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Sem as duas variáveis acima o app roda com dados de demonstração (mock) — e o build
# da Vercel FALHA de propósito (scripts/check-env.mjs) para não publicar o mock por engano.

# Como as pessoas entram: password (beta gratuito, sem envio de e-mail) | otp (exige SMTP próprio)
EXPO_PUBLIC_AUTH_MODE=password

# Endereço público do app (para links compartilhados a partir do app nativo). Na Web é automático.
# EXPO_PUBLIC_SITE_URL=https://fomo-xxxx.vercel.app

# Google Maps — só para dev build / loja (Expo Go funciona sem). Lido em app.config.js.
# Restrinja a chave Android ao package app.fomo.mobile + SHA-1; a iOS ao bundle id.
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=

# NUNCA coloque a secret key / service_role no app.
